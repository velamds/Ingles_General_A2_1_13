\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> The pond is near the entrance of the park. </span>\\\"}\"],\"styles\":\" instruction_table_background\"}", "type": "table"}], "type": "learning_points"}, {"contents": [{"content": "the Big Apple ", "type": "name"}, {"content": "another name for New York City ", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: This is my first day in the Big Apple!", "type": "example"}, {"content": "engenn4le13ob01aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": " These are words you use when you talk about Central Park.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "New Yorker ", "type": "name"}, {"content": "a person who lives in New York ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: New Yorkers love Central Park.", "type": "example"}, {"content": "engenn4le13ob01aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "Uptown ", "type": "name"}, {"content": "a neighborhood located north of the city center  ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Central Park is located in Uptown, New York.", "type": "example"}, {"content": "engenn4le13ob01aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "pedestrian ", "type": "name"}, {"content": " a person who walks in a town or city ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Many pedestrians love to walk through Central Park.", "type": "example"}, {"content": "engenn4le13ob01aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "lawn ", "type": "name"}, {"content": "an area of short grass in a garden or park ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Children like to play on the lawn.", "type": "example"}, {"content": "engenn4le13ob01aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "pond ", "type": "name"}, {"content": "a small body of water ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The pond in Central Park is full of small boats.", "type": "example"}, {"content": "engenn4le13ob01aud06", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "rumble ", "type": "name"}, {"content": "continuous, deep low sound ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: You need to go to Central Park if you want to escape the rumble of traffic!", "type": "example"}, {"content": "engenn4le13ob01aud07", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "carriage ", "type": "name"}, {"content": "a vehicle pulled by horses ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: In Central Park you can see people riding in carriages.", "type": "example"}, {"content": "engenn4le13ob01aud08", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "Think of your favorite place in your city. Is it a park? Is it a building? Do you see a lot of people there?", "type": "text"}, {"content": "Write a blog post (5-8 lines) about the place.", "type": "text"}, {"content": "Describe the place.", "type": "text"}, {"content": "Give suggestions on what people can do or see.", "type": "text"}, {"content": "Read your blog post aloud to a partner.", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I write complete statements about a city. ", "type": "text"}, {"content": "I write a blog post about a place in a city.", "type": "text"}, {"content": "I describe a place in a city.", "type": "text"}, {"content": "I give suggestions about what to do or see in a city.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"type": "welc