{"_data": [{"type": "metadata", "contents": [{"content": "Sally in New York", "type": "lesson_name"}, {"content": "A Cultural Landmark", "type": "unit_name"}, {"content": 8, "type": "position"}, {"content": "scholar > Famous Structures > The Empire State Building", "type": "origin"}, {"content": 13, "type": "lesson"}, {"content": "A2.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Accurately use information about travel and vacations in social situations.", "type": "primary"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_1"}, {"content": "Gives appropriate directions to places taking into account the type of interlocutor.", "type": "secondary_2"}, {"content": "Gives appropriate directions to places taking into account the type of interlocutor.", "type": "secondary_3"}, {"content": "Gives appropriate directions to places taking into account the type of interlocutor.", "type": "secondary_4"}, {"content": "Gives appropriate directions to places taking into account the type of interlocutor.", "type": "secondary_5"}, {"content": "Gives appropriate directions to places taking into account the type of interlocutor.", "type": "secondary_6"}, {"content": " Identifies general information in short written or spoken conversations.", "type": "secondary_7"}, {"content": "Gives appropriate directions to places taking into account the type of interlocutor.", "type": "secondary_8"}]}, {"content": "engenn4le13ob08re1img01.jpg", "type": "background_image"}, {"type": "target_word", "contents": [{"content": "eye-opener", "type": "name"}, {"content": "something surprising ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The NY Stock Exchange was a real eye-opener.", "type": "example"}, {"content": "engenn4le13ob08aud04", "type": "audio"}]}, {"type": "target_word_describer", "con